<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="default">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.45 0.48 0.5 1</ambient>
            <diffuse>0.55 0.58 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_wall">
      <static>true</static>
      <pose>2.2 0 0.45 0 0 0</pose>
      <link name="wall">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.25 1.2 0.9</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.25 1.2 0.9</size>
            </box>
          </geometry>
          <material>
            <ambient>0.75 0.22 0.12 1</ambient>
            <diffuse>0.9 0.28 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="drobotz">
      <link name="chassis">
        <pose>0 0 0.24 0 0 0</pose>
        <inertial>
          <mass>8.0</mass>
          <inertia>
            <ixx>0.13</ixx>
            <iyy>0.39</iyy>
            <izz>0.48</izz>
          </inertia>
        </inertial>
        <collision name="chassis_collision">
          <geometry>
            <box>
              <size>0.74 0.34 0.15</size>
            </box>
          </geometry>
        </collision>
        <visual name="lower_body">
          <geometry>
            <box>
              <size>0.74 0.42 0.13</size>
            </box>
          </geometry>
          <material>
            <ambient>0.03 0.22 0.5 1</ambient>
            <diffuse>0.05 0.38 0.82 1</diffuse>
          </material>
        </visual>
        <visual name="hood">
          <pose>0.19 0 0.09 0 0 0</pose>
          <geometry>
            <box>
              <size>0.34 0.4 0.08</size>
            </box>
          </geometry>
          <material>
            <ambient>0.04 0.28 0.6 1</ambient>
            <diffuse>0.08 0.48 0.95 1</diffuse>
          </material>
        </visual>
        <visual name="cabin">
          <pose>-0.07 0 0.14 0 0 0</pose>
          <geometry>
            <box>
              <size>0.29 0.33 0.17</size>
            </box>
          </geometry>
          <material>
            <ambient>0.04 0.1 0.17 1</ambient>
            <diffuse>0.08 0.19 0.29 1</diffuse>
          </material>
        </visual>
        <visual name="roof">
          <pose>-0.07 0 0.235 0 0 0</pose>
          <geometry>
            <box>
              <size>0.23 0.29 0.025</size>
            </box>
          </geometry>
          <material>
            <ambient>0.03 0.22 0.5 1</ambient>
            <diffuse>0.05 0.38 0.82 1</diffuse>
          </material>
        </visual>
        <visual name="front_bumper">
          <pose>0.38 0 -0.035 0 0 0</pose>
          <geometry>
            <box>
              <size>0.04 0.46 0.06</size>
            </box>
          </geometry>
          <material>
            <ambient>0.16 0.17 0.19 1</ambient>
            <diffuse>0.28 0.3 0.33 1</diffuse>
          </material>
        </visual>
        <visual name="rear_bumper">
          <pose>-0.38 0 -0.035 0 0 0</pose>
          <geometry>
            <box>
              <size>0.04 0.46 0.06</size>
            </box>
          </geometry>
          <material>
            <ambient>0.16 0.17 0.19 1</ambient>
            <diffuse>0.28 0.3 0.33 1</diffuse>
          </material>
        </visual>
        <visual name="left_headlight">
          <pose>0.36 0.14 0.015 0 0 0</pose>
          <geometry>
            <box>
              <size>0.025 0.07 0.035</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.8 0.25 1</ambient>
            <diffuse>1 0.9 0.5 1</diffuse>
          </material>
        </visual>
        <visual name="right_headlight">
          <pose>0.36 -0.14 0.015 0 0 0</pose>
          <geometry>
            <box>
              <size>0.025 0.07 0.035</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.8 0.25 1</ambient>
            <diffuse>1 0.9 0.5 1</diffuse>
          </material>
        </visual>
        <visual name="left_tail_light">
          <pose>-0.36 0.14 0.015 0 0 0</pose>
          <geometry>
            <box>
              <size>0.025 0.07 0.035</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.02 0.02 1</ambient>
            <diffuse>1 0.04 0.03 1</diffuse>
          </material>
        </visual>
        <visual name="right_tail_light">
          <pose>-0.36 -0.14 0.015 0 0 0</pose>
          <geometry>
            <box>
              <size>0.025 0.07 0.035</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.02 0.02 1</ambient>
            <diffuse>1 0.04 0.03 1</diffuse>
          </material>
        </visual>
        <visual name="lidar_mount">
          <pose>0.23 0 0.26 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.045</radius>
              <length>0.035</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.08 0.8 0.78 1</ambient>
            <diffuse>0.12 0.95 0.9 1</diffuse>
          </material>
        </visual>

        <sensor name="front_lidar" type="gpu_lidar">
          <pose>0.23 0 0.3 0 0 0</pose>
          <topic>/scan</topic>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <visualize>true</visualize>
          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159265</min_angle>
                <max_angle>3.14159265</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.08</min>
              <max>8.0</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
        </sensor>
      </link>

      <link name="front_left_steering_link">
        <pose>0.26 0.2 0.105 0 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.0001</ixx>
            <iyy>0.0001</iyy>
            <izz>0.0001</izz>
          </inertia>
        </inertial>
      </link>
      <link name="front_right_steering_link">
        <pose>0.26 -0.2 0.105 0 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.0001</ixx>
            <iyy>0.0001</iyy>
            <izz>0.0001</izz>
          </inertia>
        </inertial>
      </link>

      <link name="front_left_wheel">
        <pose>0.26 0.25 0.105 -1.5707963 0 0</pose>
        <inertial>
          <mass>0.35</mass>
          <inertia>
            <ixx>0.002</ixx>
            <iyy>0.002</iyy>
            <izz>0.002</izz>
          </inertia>
        </inertial>
        <collision name="wheel_collision">
          <geometry>
            <cylinder>
              <radius>0.105</radius>
              <length>0.07</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="wheel_visual">
          <geometry>
            <cylinder>
              <radius>0.105</radius>
              <length>0.07</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.035 0.035 0.04 1</ambient>
            <diffuse>0.07 0.07 0.08 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="front_right_wheel">
        <pose>0.26 -0.25 0.105 -1.5707963 0 0</pose>
        <inertial>
          <mass>0.35</mass>
          <inertia>
            <ixx>0.002</ixx>
            <iyy>0.002</iyy>
            <izz>0.002</izz>
          </inertia>
        </inertial>
        <collision name="wheel_collision">
          <geometry>
            <cylinder>
              <radius>0.105</radius>
              <length>0.07</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="wheel_visual">
          <geometry>
            <cylinder>
              <radius>0.105</radius>
              <length>0.07</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.035 0.035 0.04 1</ambient>
            <diffuse>0.07 0.07 0.08 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="rear_left_wheel">
        <pose>-0.26 0.25 0.105 -1.5707963 0 0</pose>
        <inertial>
          <mass>0.35</mass>
          <inertia>
            <ixx>0.002</ixx>
            <iyy>0.002</iyy>
            <izz>0.002</izz>
          </inertia>
        </inertial>
        <collision name="wheel_collision">
          <geometry>
            <cylinder>
              <radius>0.105</radius>
              <length>0.07</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="wheel_visual">
          <geometry>
            <cylinder>
              <radius>0.105</radius>
              <length>0.07</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.035 0.035 0.04 1</ambient>
            <diffuse>0.07 0.07 0.08 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="rear_right_wheel">
        <pose>-0.26 -0.25 0.105 -1.5707963 0 0</pose>
        <inertial>
          <mass>0.35</mass>
          <inertia>
            <ixx>0.002</ixx>
            <iyy>0.002</iyy>
            <izz>0.002</izz>
          </inertia>
        </inertial>
        <collision name="wheel_collision">
          <geometry>
            <cylinder>
              <radius>0.105</radius>
              <length>0.07</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="wheel_visual">
          <geometry>
            <cylinder>
              <radius>0.105</radius>
              <length>0.07</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.035 0.035 0.04 1</ambient>
            <diffuse>0.07 0.07 0.08 1</diffuse>
          </material>
        </visual>
      </link>

      <joint name="front_left_steering_joint" type="revolute">
        <parent>chassis</parent>
        <child>front_left_steering_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-0.55</lower>
            <upper>0.55</upper>
            <velocity>1.0</velocity>
            <effort>30</effort>
          </limit>
        </axis>
      </joint>
      <joint name="front_right_steering_joint" type="revolute">
        <parent>chassis</parent>
        <child>front_right_steering_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-0.55</lower>
            <upper>0.55</upper>
            <velocity>1.0</velocity>
            <effort>30</effort>
          </limit>
        </axis>
      </joint>
      <joint name="front_left_wheel_joint" type="revolute">
        <parent>front_left_steering_link</parent>
        <child>front_left_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
        </axis>
      </joint>
      <joint name="front_right_wheel_joint" type="revolute">
        <parent>front_right_steering_link</parent>
        <child>front_right_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
        </axis>
      </joint>
      <joint name="rear_left_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>rear_left_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
        </axis>
      </joint>
      <joint name="rear_right_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>rear_right_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
        </axis>
      </joint>

      <plugin filename="gz-sim-ackermann-steering-system"
              name="gz::sim::systems::AckermannSteering">
        <left_joint>front_left_wheel_joint</left_joint>
        <left_joint>rear_left_wheel_joint</left_joint>
        <right_joint>front_right_wheel_joint</right_joint>
        <right_joint>rear_right_wheel_joint</right_joint>
        <left_steering_joint>front_left_steering_joint</left_steering_joint>
        <right_steering_joint>front_right_steering_joint</right_steering_joint>
        <kingpin_width>0.4</kingpin_width>
        <steering_limit>0.55</steering_limit>
        <wheel_base>0.52</wheel_base>
        <wheel_separation>0.5</wheel_separation>
        <wheel_radius>0.105</wheel_radius>
        <min_velocity>-0.5</min_velocity>
        <max_velocity>0.5</max_velocity>
        <min_acceleration>-2.0</min_acceleration>
        <max_acceleration>2.0</max_acceleration>
        <steer_p_gain>3.0</steer_p_gain>
        <topic>/cmd_vel</topic>
        <odom_topic>/model/drobotz/odometry</odom_topic>
      </plugin>
    </model>
  </world>
</sdf>
